{
  "name": "@stelhacks/sdk",
  "version": "0.1.0",
  "description": "Read, verify and rebuild a StelHacks hackathon result from chain data alone",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "workspaces": [
    "bindings/*"
  ],
  "scripts": {
    "bindings": "./scripts/generate-bindings.sh",
    "build": "npm run build --workspaces --if-present && tsc",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.examples.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^14.5.0",
    "hackathon-core": "*",
    "prize-vault": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.8"
  }
}
