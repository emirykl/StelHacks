# Copy to backend/.env.local and fill in. Gitignored, and it has to stay that
# way: the service role key below reads and writes every row in the database.
#
# Nothing here may ever be copied into frontend/.env.local. That separation is
# the point of there being two files: a key that is not in the frontend's
# environment cannot reach a browser bundle by accident, whatever somebody
# prefixes it with.

SUPABASE_URL="https://rgvovkaxfwzewpmtrguz.supabase.co"

# Safe to publish. It is shipped to browsers by design and is only as powerful
# as row level security allows, which is why the policies are tested rather
# than trusted. The role tests need it to act as a signed out visitor.
SUPABASE_ANON_KEY=""

# Bypasses row level security entirely. It reaches the indexer and the wallet
# challenge verifier and nothing else. If it leaks, rotate it in the dashboard
# rather than hoping.
SUPABASE_SERVICE_ROLE_KEY=""

# Google sign in, for running the auth stack locally. In the cloud these live in
# the project's provider settings instead.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=""
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=""

# Stellar, for the indexer. Testnet while the product is being built; the
# contract build hashes are the ones recorded in docs/deployments.md.
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_RPC_URL="https://soroban-testnet.stellar.org"
