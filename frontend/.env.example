# Copy to frontend/.env.local and fill in.
#
# Everything here reaches the browser, so everything here is public. That is not
# a warning about being careful, it is the rule the file is built around: only
# values that are safe to publish belong in it, and the service role key is
# never one of them. It lives in backend/.env.local and stays there.

NEXT_PUBLIC_SUPABASE_URL="https://rgvovkaxfwzewpmtrguz.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Stellar. A visitor with no account reads the chain directly through these,
# which is what lets the proof page work without an account at all.
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
NEXT_PUBLIC_STELLAR_RPC_URL="https://soroban-testnet.stellar.org"
