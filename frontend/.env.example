NEXT_PUBLIC_SEALER_URL="http://localhost:8787"

# Which OAuth providers this deployment offers, comma separated. Empty or
# absent means email codes only, which is the one way in that needs nothing
# registered anywhere.
#
# Naming a provider here only draws its button. Each one also needs an app
# registered with the provider and its client id and secret pasted into
# Supabase under Authentication -> Providers:
#
#   github   a GitHub OAuth App, free, two minutes, no cloud console
#   google   an OAuth client in Google Cloud Console, plus a consent screen
NEXT_PUBLIC_OAUTH_PROVIDERS=""

# Where the platform's cut is paid, and it has to be a Stellar address this
# deployment controls. A tier above community quotes a rate, the rate goes into
# the frozen constitution, and the contract pays this address at settlement.
#
# Leaving it empty is a working configuration: every event is created at a zero
# rate. What is refused is a rate above zero with nowhere to send it, which the
# create page blocks rather than quietly turning into a free event.
NEXT_PUBLIC_PLATFORM_FEE_COLLECTOR=""

# Who hears about a new organizer application, and the key that sends it.
#
# Both optional and both needed together. Without them applications still arrive
# and are still answered at /admin/organizers; nobody is told they are waiting.
# The default sender is Resend's shared address, which only delivers to the
# account that owns the Resend key, so nothing has to be verified to start.
RESEND_API_KEY=""
APPLICATIONS_EMAIL=""
