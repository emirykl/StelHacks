# Copy to .env.local and fill in. `.env.local` is gitignored and must stay that
# way: one of the values below reads and writes every row in the database.

# The Supabase project. Both of these are safe to publish; the anon key is
# shipped to browsers by design and is only as powerful as row level security
# allows, which is the reason the policies are tested rather than trusted.
SUPABASE_URL="https://rgvovkaxfwzewpmtrguz.supabase.co"
SUPABASE_ANON_KEY=""

# Bypasses row level security entirely. It reaches the indexer and the wallet
# challenge verifier and nothing else, and it never reaches a browser. If this
# leaks, rotate it in the dashboard rather than hoping.
SUPABASE_SERVICE_ROLE_KEY=""

# Google sign in. Created in the Google Cloud console as an OAuth client of type
# "Web application", with the Supabase callback URL as an authorized redirect.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=""
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=""

# Stellar. Testnet while the product is being built; the contract addresses are
# the ones recorded in docs/deployments.md.
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_RPC_URL="https://soroban-testnet.stellar.org"
STELLAR_HACKATHON_CORE_WASM_HASH="db124ad0fa0a9aba6ba61d223f781e3f9be543a6a985308b3379d72fcd379dcc"
STELLAR_PRIZE_VAULT_WASM_HASH="afc98888d9321be76160951ce072b52f08c7f3a6a0e29ee1ac9e3c0aa4783ffb"
